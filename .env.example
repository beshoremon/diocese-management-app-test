# Supabase — get these from your Supabase project settings (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key (SERVER ONLY — never expose to client). Used for admin operations:
# push dispatcher + إضافة خدام (/api/servants/create creates login accounts) +
# النسخ الاحتياطي (/api/backup/* — scheduled backups, auth-account restore, stored files).
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Web Push (وحدة الإشعارات) — generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@example.com
# Optional: protects GET /api/notifications/dispatch and GET /api/backup/cron
# (Vercel Cron sends it automatically)
CRON_SECRET=

# ---------------------------------------------------------------------------
# PWA branding (Vercel → Project → Settings → Environment Variables)
# NEXT_PUBLIC_* values are inlined at BUILD time → redeploy after changing them.
# Leave any variable empty to keep the built-in default:
#   name "Diocese Management App" · short name "D.M.A" · bundled D.M.A logo.
# ---------------------------------------------------------------------------
# App name (manifest `name`, <title>) and home-screen label (manifest `short_name`)
NEXT_PUBLIC_APP_NAME=Diocese Management App
NEXT_PUBLIC_APP_SHORT_NAME=D.M.A
NEXT_PUBLIC_APP_DESCRIPTION=Diocese Management App — تطبيق إدارة كنائس وخدمات الإيبارشية
# App icon: public URL of a SQUARE image ≥ 512px (PNG/JPG/WebP/SVG), e.g. a
# file in Supabase Storage. Served resized at /branding/icon/{96|180|192|512}
# (PWA icons, favicon, apple-touch-icon, push notifications).
NEXT_PUBLIC_APP_ICON_URL=
# Diocese name + logo: header fallback (before a church is resolved), login /
# signup pages, offline page. Logo falls back to the app icon when empty.
NEXT_PUBLIC_DIOCESE_NAME=Diocese Management App
NEXT_PUBLIC_DIOCESE_LOGO_URL=
# Optional colours (quote them in .env files — a bare # starts a comment)
NEXT_PUBLIC_THEME_COLOR="#1e3a8a"
NEXT_PUBLIC_BACKGROUND_COLOR="#001f4e"
