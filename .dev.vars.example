# Local Cloudflare preview (`npm run cf:preview`) reads runtime variables from
# `.dev.vars` (git-ignored). Copy this file to `.dev.vars` and fill it in —
# the same keys as .env.example. NEXT_PUBLIC_* values are ALSO needed at
# build time (put them in .env.local for `next build`).
NEXTJS_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=
